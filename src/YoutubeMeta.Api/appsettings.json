{
  "ConnectionStrings": {
    "Default": "Server=(localdb)\\MSSQLLocalDB;Database=YoutubeMeta;Trusted_Connection=True;TrustServerCertificate=True;Connection Timeout=30"
  },
  "App": {
    "FrontBaseUrl": "",
    "ForceHttps": false,
    "PublicBaseUrl": ""
  },
  "Auth": {
    "AdminUser": "admin",
    "AdminDisplayName": "Administrador",
    "AdminPasswordHash": "",
    "JwtKey": "",
    "JwtIssuer": "YoutubeMeta",
    "TokenHours": 12
  },
  "Security": {
    "SecretKey": ""
  },
  "Platforms": {
    "Disabled": [ "LINKEDIN" ]
  },
  "Storage": {
    "Root": "D:\\Kaltrum\\5.0 YoutubeMeta\\storage",
    "MaxUploadGb": 20,
    "TusTtlMinutes": 1440,
    "StreamChunkMb": 10,
    "StreamTicketMinutes": 30,
    "AllowedExtensions": [ "mp4", "mov", "m4v", "webm", "mkv", "avi" ]
  },
  "Google": {
    "ClientId": "",
    "ClientSecret": "",
    "RedirectUri": "http://localhost:5080/api/Connection/Youtube/Callback",
    "RegionCode": "EC",
    "ApplicationName": "YoutubeMeta"
  },
  "Meta": {
    "GraphVersion": "v26.0",
    "AppId": "",
    "AppSecret": "",
    "WebhookVerifyToken": ""
  },
  "Tiktok": {
    "ClientKey": "",
    "ClientSecret": "",
    "RedirectUri": "",
    "ChunkMb": 32
  },
  "Linkedin": {
    "ClientId": "",
    "ClientSecret": "",
    "RedirectUri": "",
    "OrgClientId": "",
    "OrgClientSecret": "",
    "OrgRedirectUri": "",
    "ApiVersion": "202610",
    "MaxVideoWaitMinutes": 15
  },
  "Teams": {
    "TenantId": "",
    "ClientId": "",
    "ClientSecret": "",
    "RedirectUri": ""
  },
  "Jobs": {
    "VideoPublish": {
      "Enabled": true,
      "RunOnStartup": true,
      "DelaySeconds": 30,
      "LeaseMinutes": 10,
      "YoutubeChunkMb": 32,
      "PlatformBatch": 3,
      "PollBatch": 20,
      "BackoffMinutes": 5,
      "ProgressEverySeconds": 15,
      "PollMaxHours": 24
    },
    "StorageCleanup": {
      "Enabled": true,
      "DelayMinutes": 60,
      "TempPosterHours": 24,
      "EventRetentionDays": 365
    },
    "TokenKeepAlive": {
      "Enabled": true,
      "DelayHours": 168
    },
    "Metrics": {
      "Enabled": true,
      "DelayMinutes": 60,
      "Batch": 100
    },
    "Inbox": {
      "Enabled": true,
      "DelaySeconds": 5,
      "Batch": 20,
      "LeaseMinutes": 5,
      "MaxAttempts": 5,
      "BackoffSeconds": 30,
      "YoutubePollMinutes": 10,
      "TeamsPollMinutes": 5,
      "TelegramPollSeconds": 15,
      "TeamsThreadDays": 14,
      "EventRetentionDays": 30,
      "MessageRetentionMonths": 12,
      "MetaHumanAgentTag": false,
      "InviteDays": 30,
      "KeepReceivedFiles": true,
      "KeepFileMaxMb": 50
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "System": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": { "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {Message:lj}{NewLine}{Exception}" }
      },
      {
        "Name": "File",
        "Args": {
          "path": "C:\\Logs\\YoutubeMeta\\log-.txt",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 30,
          "fileSizeLimitBytes": 268435456,
          "rollOnFileSizeLimit": true
        }
      }
    ],
    "Enrich": [ "FromLogContext" ]
  },
  "AllowedHosts": "*"
}
