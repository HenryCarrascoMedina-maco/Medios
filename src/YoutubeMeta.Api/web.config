<?xml version="1.0" encoding="utf-8"?>
<!--
  IIS corta el cuerpo de la petición antes de que llegue a la aplicación: las partes TUS son de
  10 MB, se deja margen hasta 64 MB (igual que MaxRequestBodySize en Program/DependencyInjection).
  El handler de ASP.NET Core lo agrega el SDK al publicar.
  Ver README: el app pool debe quedar "AlwaysRunning" para que el job de publicación no se detenga.
-->
<configuration>
  <system.webServer>
    <security>
      <requestFiltering>
        <requestLimits maxAllowedContentLength="67108864" />
      </requestFiltering>
    </security>
    <webSocket enabled="true" />
  </system.webServer>
</configuration>
